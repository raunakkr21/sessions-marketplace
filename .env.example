# --- Google OAuth ---
# Create credentials at https://console.developers.google.com/
# Under "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth 2.0 Client ID"
# Application type: Web application
# Authorized redirect URIs: http://localhost/api/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=210280056107-n1qklkca83045g0nsm6h5mqg3sai24cc.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
# The URI Google will redirect to after authentication.
# Must exactly match what is configured in Google Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/auth/google/callback/

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=b56e843e0a9bf00e86e583e1a74a0b2f14fc05aaefd7fb76d2d691ba0696f2a72880727f8322bf5c38ca3e29944d709c34d707830ef38f2bbecded95da5acfb2
